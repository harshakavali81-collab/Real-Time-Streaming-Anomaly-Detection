{
  "uid": "streamwatch-ai",
  "title": "StreamWatch AI — Synthetic Kafka Observability",
  "id": null,
  "version": 1,
  "schemaVersion": 39,
  "timezone": "browser",
  "tags": [
    "synthetic",
    "local",
    "streamwatch"
  ],
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Event throughput per second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "streamwatch-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(streamwatch_processed_total[5m]))",
          "legendFormat": "Event throughput per second"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Anomaly rate per second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "streamwatch-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(streamwatch_anomalies_total[5m]))",
          "legendFormat": "Anomaly rate per second"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Worker processing p95 seconds",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "streamwatch-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(streamwatch_inference_seconds_bucket[5m])) by (le))",
          "legendFormat": "Worker processing p95 seconds"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Malformed event rate",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "streamwatch-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(streamwatch_invalid_total[5m]))",
          "legendFormat": "Malformed event rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Worker availability",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "streamwatch-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "streamwatch_consumer_up",
          "legendFormat": "Worker availability"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    }
  ]
}
